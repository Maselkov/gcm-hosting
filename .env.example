# Bases are served at <slug>.DOMAIN: point DOMAIN and *.DOMAIN at this host.
DOMAIN=example.net
ACME_EMAIL=you@example.net
# A Cloudflare API token for DOMAIN's zone, with Zone / DNS / Edit and
# Zone / Zone / Read: Traefik adds the TXT record that proves the
# wildcard certificate is yours. See README.md.
CF_DNS_API_TOKEN=
# Let's Encrypt's staging CA, for a first try that can't use up the
# real rate limits (its certificates aren't trusted by browsers):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# A Discord application's OAuth2 client; its redirect is
# https://DOMAIN/login/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Who may use the control panel (/admin): comma-separated identities, as
# "discord:<your Discord user id>" (Discord: Settings -> Advanced ->
# Developer Mode, then right-click yourself -> Copy User ID).
ADMIN_IDENTITIES=
# Prefix of every base's container, volumes and router. Only for two
# instances on one host (deploy/README.md): give each its own.
INSTANCE=gcm
# The image every base runs.
IMAGE=ghcr.io/maselkov/gtnh-craft-monitor:6.0
# Absolute path ON THE HOST to game data bundles every base reads
# (<version>/ folders), indexed for them automatically. Empty: each base
# downloads its own.
GAMEDATA_SHARED_DIR=
# Download every published version into it (~8.5 GB now). 0: only what
# you put there yourself.
GAMEDATA_DOWNLOAD=1
# Disk per base; one over it is stopped until raised (app.py set-quota).
QUOTA_MB=200
MAX_BASES_PER_ACCOUNT=1
MAX_BASES=10
# A Discord account must be this old to make a base (0: any age).
MIN_ACCOUNT_AGE_DAYS=30
# A base the game never reported to is removed after NEVER_CONNECTED_DAYS;
# one it stopped reporting to is flagged after INACTIVE_DAYS (0: off).
NEVER_CONNECTED_DAYS=7
INACTIVE_DAYS=60
# Requests per second from one IP to one base, on average and in a burst.
RATE_LIMIT_AVERAGE=50
RATE_LIMIT_BURST=500
# Enough for a 6.0 base reading GAMEDATA_SHARED_DIR; 256m without it
# (each base then builds its own game data index), 512m before 6.0.
MEMORY_LIMIT=160m
CPU_LIMIT=0.5
# The only hosts a base's webhooks (set on its page) may post to: exact
# hostnames, comma-separated. Empty: any.
#WEBHOOK_HOSTS=discord.com,discordapp.com,ptb.discord.com,canary.discord.com,hooks.slack.com
