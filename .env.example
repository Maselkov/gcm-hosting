# Bases are served at <slug>.DOMAIN: point DOMAIN and *.DOMAIN at this host.
DOMAIN=example.net
ACME_EMAIL=you@example.net
# A Cloudflare API token for DOMAIN's zone, with Zone / DNS / Edit and
# Zone / Zone / Read: Traefik adds the TXT record that proves the
# wildcard certificate is yours. See README.md.
CF_DNS_API_TOKEN=
# Let's Encrypt's staging CA, for a first try that can't use up the
# real rate limits (its certificates aren't trusted by browsers):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# A Discord application's OAuth2 client; its redirect is
# https://DOMAIN/login/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Who may use the control panel (/admin): comma-separated identities, as
# "discord:<your Discord user id>" (Discord: Settings -> Advanced ->
# Developer Mode, then right-click yourself -> Copy User ID).
ADMIN_IDENTITIES=
# Prefix of every base's container, volumes and router. Only for two
# instances on one host (deploy/README.md): give each its own.
INSTANCE=gcm
# The image every base runs.
IMAGE=ghcr.io/maselkov/gtnh-craft-monitor:5.1
# Absolute path ON THE HOST to game data bundles every base reads
# (<version>/ folders), indexed for them automatically. Empty: each base
# downloads its own.
GAMEDATA_SHARED_DIR=
# Disk per base; one over it is stopped until raised (app.py set-quota).
QUOTA_MB=200
MAX_BASES_PER_ACCOUNT=1
MAX_BASES=10
MEMORY_LIMIT=512m
CPU_LIMIT=0.5
