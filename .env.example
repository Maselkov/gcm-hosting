# Bases are served at <slug>.DOMAIN: point DOMAIN and *.DOMAIN at this host.
DOMAIN=example.net
ACME_EMAIL=you@example.net
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# A Discord application's OAuth2 client; its redirect is
# https://DOMAIN/login/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The image every base runs.
IMAGE=ghcr.io/maselkov/gtnh-craft-monitor:5.1
# Absolute path ON THE HOST to game data bundles every base reads
# (<version>/ folders). Empty: each base downloads its own.
GAMEDATA_SHARED_DIR=
# Disk per base; one over it is stopped until raised (app.py set-quota).
QUOTA_GB=1
MAX_BASES_PER_ACCOUNT=1
MAX_BASES=30
MEMORY_LIMIT=256m
CPU_LIMIT=0.5
